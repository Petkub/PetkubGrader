# MyGrader Caddy reverse proxy.
#
# Served on plain :80. Two ways to put it on the internet:
#   - Cloudflare Tunnel (docs/DEPLOY-TH.md): cloudflared terminates TLS and
#     forwards to caddy:80 — keep `:80` as is.
#   - Public VPS: replace `:80` with your domain. Caddy auto-issues a
#     Let's Encrypt cert.

{
    servers {
        # Trust X-Forwarded-* from cloudflared / LAN proxies so Next.js sees
        # the original https scheme and host.
        trusted_proxies static private_ranges
    }
}

:80 {
    encode zstd gzip

    # Next.js handles everything by default.
    reverse_proxy nextjs:3000

    # Optional: expose FastAPI directly for debugging (comment out in prod).
    # handle_path /api/* {
    #     reverse_proxy fastapi:8000
    # }

    log {
        output stdout
        format console
    }
}
